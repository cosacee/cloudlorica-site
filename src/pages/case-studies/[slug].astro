---
import Layout from '../../layouts/Layout.astro';
import { site } from '../../data/site.js';
import { caseStudies } from '../../data/caseStudies.js';
import DataLayerDiagram from '../../components/DataLayerDiagram.astro';

export function getStaticPaths() {
  return caseStudies.map((study) => ({
    params: { slug: study.slug },
    props: { study },
  }));
}

const { study } = Astro.props;

const isAI = study.provenance !== 'manual';
const provenanceLabel = isAI ? 'AI Assisted Publish' : 'Manual';
const provenanceDetail = isAI
  ? 'Drafted with AI assistance, then reviewed, corrected and edited before publication.'
  : 'Written by hand, without AI drafting.';
---

<Layout title={study.title} description={study.summary}>
  <section style="padding-block:4rem 3rem">
    <div class="wrap">
      <p class="eyebrow">
        <a href="/#work">← All work</a>
      </p>

      <div style="display:flex;gap:0.6rem;align-items:center;margin-bottom:1rem">
        <span class={isAI ? 'badge badge-ai' : 'badge badge-manual'}>{provenanceLabel}</span>
      </div>

      <h1 style="max-width:26ch">{study.title}</h1>
      <p class="lede">{study.summary}</p>

      <div class="tag-row" style="margin-top:1.5rem">
        {study.stack.map((t) => <span class="tag">{t}</span>)}
      </div>

      <div class="tag-row" style="margin-top:0.5rem">
        {study.keywords.map((k) => <span class="tag tag-kw">{k}</span>)}
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="specs" style="max-width:44rem">
        <div class="spec"><dt>Role</dt><dd>{study.role}</dd></div>
        <div class="spec"><dt>Result</dt><dd>{study.metric}</dd></div>
        <div class="spec"><dt>Written</dt><dd>{provenanceDetail}</dd></div>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <div class="prose">
        <h2>Context</h2>
        <p>{study.context}</p>

        {study.diagram && (
          <details class="data-drawer">
            <summary>{study.diagramLabel || 'Show diagram'}</summary>
            <DataLayerDiagram />
          </details>
        )}

        <h2>Constraints</h2>
        <ul>
          {study.constraints.map((c) => <li>{c}</li>)}
        </ul>

        <h2>Decisions</h2>
        {study.decisions.map((d) => (
          <>
            <h3>{d.title}</h3>
            <p>{d.body}</p>
          </>
        ))}

        <h2>Outcome</h2>
        <ul>
          {study.outcome.map((o) => <li>{o}</li>)}
        </ul>

        <h2>What it taught me</h2>
        <blockquote>{study.lessons}</blockquote>
      </div>
    </div>
  </section>

  <section>
    <div class="wrap">
      <p class="dim" style="font-size:0.9rem">
        Addresses, hostnames and identifiers in this write-up are abstracted or
        generalised. If you would like the specific detail, ask — I am happy to walk
        through it directly.
      </p>
      <p style="margin-top:2rem"><a href="/#work">← Back to all work</a></p>
    </div>
  </section>
</Layout>

<style>
  /* Collapsible divider between paragraphs: the summary reads as a rule
     across the column and opens the diagram underneath it. */
  .data-drawer {
    margin-block: 2.25rem;
    border-block: 1px solid var(--border);
  }

  .data-drawer > summary {
    cursor: pointer;
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 0.9rem;
    font-family: var(--mono);
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-dim);
    transition: color 120ms ease;
  }

  .data-drawer > summary::-webkit-details-marker { display: none; }
  .data-drawer > summary::marker { content: ''; }

  .data-drawer > summary:hover { color: var(--accent); }

  .data-drawer > summary::after {
    content: "show  +";
    color: var(--accent);
    white-space: nowrap;
  }

  .data-drawer[open] > summary::after { content: "hide  −"; }

  .data-drawer[open] > summary {
    border-bottom: 1px solid var(--border);
    margin-bottom: 1.25rem;
  }

  @media (max-width: 640px) {
    .data-drawer > summary { font-size: 0.7rem; letter-spacing: 0.1em; }
  }
</style>
